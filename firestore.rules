rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function getEmail() {
      return request.auth != null && request.auth.token != null && request.auth.token.email != null 
        ? request.auth.token.email.lower() 
        : '';
    }

    function isDefaultAdmin() {
      return getEmail() == 'kiddepressed03@gmail.com' || getEmail() == 'hellofrostingfairy@gmail.com';
    }

    function isAdminDoc() {
      return getEmail() != '' && exists(/databases/$(database)/documents/admins/$(getEmail()));
    }

    function isAdmin() {
      return isDefaultAdmin() || isAdminDoc();
    }

    function getAdminRole() {
      return isDefaultAdmin() 
        ? 'admin' 
        : (isAdminDoc() && 'role' in get(/databases/$(database)/documents/admins/$(getEmail())).data
            ? get(/databases/$(database)/documents/admins/$(getEmail())).data.role 
            : 'admin');
    }

    function isRoleAdmin() {
      return isAdmin() && getAdminRole() == 'admin';
    }

    function isRoleChefOrAdmin() {
      return isAdmin() && (getAdminRole() == 'admin' || getAdminRole() == 'chef');
    }

    // Products collection: public read, role-gated write
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isRoleChefOrAdmin();
      allow delete: if isRoleAdmin();
    }

    // Reviews collection: public read, authenticated user write, user/admin delete
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1 
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0 
        && request.resource.data.comment.size() <= 1000;
      allow update: if request.auth != null 
        && (resource.data.userId == request.auth.uid || isRoleChefOrAdmin())
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.productId == resource.data.productId
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1 
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0 
        && request.resource.data.comment.size() <= 1000;
      allow delete: if request.auth != null 
        && (resource.data.userId == request.auth.uid || isRoleChefOrAdmin());
    }

    // Categories collection: public read, admin-only write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isRoleAdmin();
    }

    // Orders collection: customer order placement, order lookup, chef/admin updates
    match /orders/{orderId} {
      allow read, create, update: if true;
      allow delete: if isRoleAdmin();
    }

    // Customers collection: mobile phone authenticated profiles and returning customer records
    match /customers/{customerId} {
      allow read, create, update: if true;
      allow delete: if isRoleAdmin();
    }

    match /otp_codes/{phoneNumber} {
      allow read, write: if true;
    }

    match /customer_sessions/{tokenHash} {
      allow read, write: if true;
    }

    // Payment sessions: admin-only reads or authenticated user's own session read, server-only writes
    match /payment_sessions/{sessionId} {
      allow read: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if false;
    }

    // Admins collection: read allowed for signed-in admins only, write for role admin
    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if isRoleAdmin();
    }

    // Settings collection: public read, admin-only write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isRoleAdmin();
    }

    // Audit logs collection: create and read for signed-in admins, update/delete forbidden
    match /auditLogs/{logId} {
      allow create, read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
