{
  "entities": {
    "products": {
      "title": "products",
      "description": "Bakery product catalog",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "prepTime": { "type": "number" },
        "cookTime": { "type": "number" },
        "difficulty": { "type": "string" },
        "servings": { "type": "number" },
        "rating": { "type": "number" },
        "votes": { "type": "number" },
        "category": { "type": "string" },
        "priceOptions": { "type": "array" }
      },
      "required": ["name", "category", "priceOptions"]
    },
    "orders": {
      "title": "orders",
      "description": "Customer purchase orders",
      "type": "object",
      "properties": {
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "cakeType": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["customerName", "status"]
    },
    "admins": {
      "title": "admins",
      "description": "Admin authorization list",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string" }
      },
      "required": ["email"]
    },
    "payment_sessions": {
      "title": "payment_sessions",
      "description": "Secure payment gateway sessions",
      "type": "object",
      "properties": {
        "razorpayOrderId": { "type": "string" },
        "amountInPaise": { "type": "number" },
        "totalPrice": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["razorpayOrderId", "amountInPaise", "status"]
    },
    "reviews": {
      "title": "reviews",
      "description": "Customer product reviews and ratings",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["productId", "userId", "userName", "rating", "comment"]
    }
  }
}
